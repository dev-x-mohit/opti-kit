{
  "name": "@dev_x_mohit/opti-kit",
  "version": "1.2.0",
  "description": "OptiKit is a zero-dependency, ultra-lightweight, and fully tree-shakeable JavaScript/TypeScript utility monorepo library. It ships 37 hand-optimized isomorphic modules. Every function is side-effect free, individually importable, and ships with full TypeScript declarations, CJS/ESM dual output, 430 utilities, and 419 unit tests.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "docs": "typedoc src/index.ts --out ../../apps/showcase/public/api --name \"OptiKit API\" --tsconfig tsconfig.docs.json"
  },
  "keywords": [
    "utilities",
    "utils",
    "typescript",
    "tree-shakeable",
    "lightweight",
    "zero-dependencies",
    "esm",
    "cjs",
    "isomorphic",
    "event-emitter",
    "safe-storage",
    "uuid",
    "sha256",
    "generate-token",
    "color-converter",
    "relative-time",
    "string-utils",
    "array-utils",
    "math-utils",
    "object-utils",
    "number-format",
    "validation",
    "debounce",
    "throttle",
    "deep-clone",
    "deep-merge",
    "flatten-object",
    "interpolate",
    "slugify",
    "truncate",
    "titlecase",
    "ordinal",
    "compact-number",
    "median",
    "standard-deviation",
    "lodash-alternative",
    "ramda-alternative",
    "underscore-alternative",
    "javascript-utilities",
    "js-utils",
    "ts-utils",
    "helper-functions",
    "functional-programming",
    "curry",
    "pipe",
    "compose",
    "memoize",
    "retry",
    "async-pool",
    "lru-cache",
    "cookie-utils",
    "clipboard",
    "format-currency",
    "format-date",
    "email-validation",
    "url-parser",
    "group-by",
    "chunk-array",
    "shuffle-array",
    "unique-array",
    "random-uuid",
    "hash-function",
    "base64",
    "hex-encode",
    "no-dependencies",
    "supply-chain-safe",
    "bundle-size",
    "treeshaking"
  ],
  "author": "Mohit Lakhara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-x-mohit/opti-kit.git",
    "directory": "packages/opti-kit"
  },
  "homepage": "https://opti-kit-showcase.vercel.app",
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/dev-x-mohit"
  },
  "bugs": {
    "url": "https://github.com/dev-x-mohit/opti-kit/issues"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "lodash": "^4.18.1",
    "tsup": "^8.0.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
